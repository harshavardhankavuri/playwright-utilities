{
  "name": "playwright-utilities",
  "version": "1.0.0",
  "description": "Playwright test automation framework with Page Object Model",
  "scripts": {
    "test": "npx playwright test",
    "test:dev": "cross-env ENV=dev npx playwright test",
    "test:qa": "cross-env ENV=qa npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:chromium": "npx playwright test --project=chromium",
    "test:single": "cross-env REPORT_MODE=single npx playwright test",
    "test:single:chromium": "cross-env REPORT_MODE=single npx playwright test --project=chromium",
    "report:html": "npx playwright show-report reports/html",
    "report:allure:generate": "npx allure generate allure-results --clean -o reports/allure",
    "report:allure:generate:single": "node scripts/allure-single.js",
    "report:allure:open": "npx allure open reports/allure",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "report:allure:single": "npm run report:allure:generate:single && npx allure open reports/allure-single",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "k6:smoke":            "k6 run k6/tests/smoke.test.js",
    "k6:load":             "k6 run k6/tests/load.test.js",
    "k6:stress":           "k6 run k6/tests/stress.test.js",
    "k6:spike":            "k6 run k6/tests/spike.test.js",
    "k6:crud":             "k6 run k6/tests/crud.test.js",
    "k6:batch":            "k6 run k6/tests/batch.test.js",
    "k6:smoke:dashboard":  "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=k6-report/smoke-dashboard.html k6 run k6/tests/smoke.test.js",
    "k6:load:dashboard":   "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=k6-report/load-dashboard.html k6 run k6/tests/load.test.js",
    "k6:stress:dashboard": "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=k6-report/stress-dashboard.html k6 run k6/tests/stress.test.js",
    "k6:spike:dashboard":  "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=k6-report/spike-dashboard.html k6 run k6/tests/spike.test.js",
    "k6:crud:dashboard":   "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=k6-report/crud-dashboard.html k6 run k6/tests/crud.test.js",
    "k6:batch:dashboard":  "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=k6-report/batch-dashboard.html k6 run k6/tests/batch.test.js"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "typescript",
    "pom",
    "allure"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/form-data": "^2.5.2",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "allure-commandline": "^2.34.0",
    "allure-js-commons": "^3.8.0",
    "allure-playwright": "^3.2.2",
    "axios": "^1.16.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.2",
    "form-data": "^4.0.5",
    "pdf-parse": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
